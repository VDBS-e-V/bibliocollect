# Vorlage für Hosting ohne SSH (z. B. Webspace bei einem Provider). Kopieren nach .env und Werte ersetzen.
# Anleitung: docs/HOSTING_SHARED.md

APP_NAME=BiblioCollect
APP_ENV=production
APP_DEBUG=false
# Wird mit `php artisan key:generate --show` auf deinem Rechner erzeugt (Ergebnis hier eintragen).
APP_KEY=
APP_URL=https://bibliothek.example.org
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
# Ortszeit für Anzeige, Speicherung und Zeitplan
APP_TIMEZONE=Europe/Berlin
BUSINESS_TIMEZONE=Europe/Berlin
# Der Hoster leitet Anfragen über einen Proxy weiter. * vertraut ihm; mit Adressliste (a.b.c.d,e.f.g.h) einschränken.
TRUSTED_PROXIES=*

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Datenbank (MySQL/MariaDB) laut Provider-Kundenbereich
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Vor der ersten Migration müssen Sitzungen und Zwischenspeicher ohne Datenbank laufen.
# Nach der Einrichtung auf "database" umstellen (Sitzungen bleiben dann bei Neustarts erhalten).
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookies nur über HTTPS und nicht von fremden Seiten mitschicken
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database

# Cover liegen direkt in public/covers (kein storage:link nötig, der ohne SSH nicht geht)
FILESYSTEM_DISK=local
CATALOG_COVER_DISK=covers
CATALOG_COVER_OPEN_LIBRARY=true
# Kostenloser Google-Books-Key (optional)
CATALOG_COVER_GOOGLE_BOOKS_KEY=
# Wie viele Bestandstitel pro Nacht (03:30 Uhr) ein Cover nachgeladen bekommen (höchstens 1000).
CATALOG_COVER_DAILY_LIMIT=200
# Wie viele offene Qualitätsfälle pro Nacht (02:30 Uhr) bei der DNB nachgeschlagen werden (höchstens 500).
CATALOG_QUALITY_DAILY_LIMIT=60

# Mailversand für Erinnerungen (SMTP-Daten aus dem Kundenbereich des Providers)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bibliothek@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Einrichtungsseite /_setup (nur zum Einrichten setzen, danach LEEREN). Mindestens 24 Zeichen, zufällig.
SETUP_TOKEN=
# Web-Cron /_cron/<Token>, falls der Provider nur URLs aufrufen kann. Mindestens 24 Zeichen, zufällig.
CRON_TOKEN=
# Betriebsmeldungen (Fehler, ausgefallener Cron, fehlgeschlagene Jobs) an diese Adresse. Statusadresse /_status nutzt CRON_TOKEN oder STATUS_TOKEN.
ALERT_EMAIL=
STATUS_TOKEN=

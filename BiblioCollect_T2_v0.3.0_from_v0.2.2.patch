+final class Patron extends Model
+{
+    use HasUlids;
+
+    /** @var list<string> */
+    protected $fillable = [
+        'library_number',
+        'kind',
+        'status',
+        'first_name',
+        'last_name',
+        'birth_date',
+        'email',
+        'school_class_id',
+        'leaving_on',
+        'blocked_at',
+        'blocked_reason',
+    ];
+
+    /** @return BelongsTo<SchoolClass, $this> */

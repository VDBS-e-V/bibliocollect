+    letter-spacing: .08em;
+    text-transform: uppercase;
+}
+
+.bc-catalog-search {
+    border-top: 5px solid var(--action-secondary);
+    background: var(--action-primary);
+    padding: 1.4rem 1.5rem 1.25rem;
+}

+.bc-side-panel h2 { margin: 0; font-size: 1.05rem; font-weight: 900; }
+.bc-side-panel p { margin: .55rem 0 0; color: var(--text-secondary); font-size: var(--text-sm); }
+.bc-plain-links { display: grid; gap: .45rem; margin: .65rem 0 0; padding: 0; list-style: none; }
+
+.bc-work-layout {
+    display: grid;
+    grid-template-columns: 12.5rem minmax(0, 1fr);
+    gap: 2rem;
+}
+
+.bc-section-nav {
+    align-self: start;
+    border: 1px solid var(--border-default);

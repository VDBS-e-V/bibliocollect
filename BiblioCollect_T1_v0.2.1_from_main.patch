+.bc-catalog-search__heading h1 {
+    margin: 0;
+    font-size: clamp(1.8rem, 4vw, 2.45rem);
+    font-weight: 900;
+    letter-spacing: -.02em;
+}
+
+.bc-catalog-search__form {
+    display: grid;
+    grid-template-columns: minmax(9.5rem, 13rem) minmax(12rem, 1fr) auto;
+    gap: .45rem;
+    margin-top: 1rem;
+}
+
+.bc-catalog-search__scope,
+.bc-catalog-search__input {
+    min-height: 3rem;
+    border: 1px solid var(--vdbs-ink);
+    border-radius: .15rem;
+    background: var(--vdbs-white);
+    color: var(--vdbs-ink);
+    padding: .65rem .75rem;
+}
+
+.bc-catalog-search__input::placeholder { color: #52605b; }
+.bc-catalog-search__meta { margin-top: .6rem; font-size: var(--text-sm); }
+
+.bc-home-layout {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
+    gap: 2rem;
+    margin-top: 2rem;
+}
+
+.bc-home-layout__main,
+.bc-work-layout__main { min-width: 0; }
+
+.bc-content-section {
+    margin-top: 1.75rem;
+}
+
+.bc-content-section:first-child { margin-top: 0; }
+
+.bc-section-heading {
+    display: flex;
+    align-items: baseline;
+    justify-content: space-between;

APP_NAME="BiblioCollect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
# Zeitzone für Anzeige, Speicherung und Zeitplan (Erinnerungen um 07:00 meint 07:00 Ortszeit).
APP_TIMEZONE=Europe/Berlin
BUSINESS_TIMEZONE=Europe/Berlin

# Briefpapier bei Ausdrucken (A4): farbe, sw oder aus.
LETTERHEAD=farbe

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Katalog: externe Metadaten und Cover (siehe docs/CATALOG_INTAKE.md)
CATALOG_DNB_TIMEOUT=10
# Weitere Quellen für Bücher in anderen Sprachen (Open Library, Google Books); mit false abschaltbar
CATALOG_LOOKUP_OPEN_LIBRARY=true
CATALOG_LOOKUP_GOOGLE_BOOKS=true
CATALOG_LOOKUP_TIMEOUT=10
CATALOG_COVER_OPEN_LIBRARY=true
CATALOG_COVER_GOOGLE_BOOKS_KEY=
# Wie viele Bestandstitel pro Nacht (03:30 Uhr) ein Cover nachgeladen bekommen (höchstens 1000).
CATALOG_COVER_DAILY_LIMIT=200
# Wie viele offene Qualitätsfälle pro Nacht (02:30 Uhr) bei der DNB nachgeschlagen werden (höchstens 500).
CATALOG_QUALITY_DAILY_LIMIT=60

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bibliocollect@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Einrichtungsseite /_setup (nur zum Einrichten setzen, danach LEEREN). Mindestens 24 Zeichen, zufällig. Leer = Seite aus.
SETUP_TOKEN=

# Betrieb: Web-Cron (/_cron), Statusadresse (/_status) und Fehlermeldungen per Mail. Leer = aus.
CRON_TOKEN=
STATUS_TOKEN=
ALERT_EMAIL=
